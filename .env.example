# Copy this file to .env and fill in your own credentials.
# NEVER commit the real .env file — it is already in .gitignore.

# ---------- CognoDB Cloud ----------
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# ---------- Neo4j Aura Free ----------
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------- Memgraph Cloud (Free tier) ----------
MEMGRAPH_HOST=<instance-host-or-ip>
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=<your-username>
MEMGRAPH_PASSWORD=<your-password>

# ---------- ArangoDB Oasis (Free trial) ----------
ARANGO_URL=https://<instance-id>.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=benchmark

# ---------- TigerGraph Cloud (Free tier) ----------
TIGERGRAPH_HOST=https://<instance-id>.i.tgcloud.io
TIGERGRAPH_USER=tigergraph
TIGERGRAPH_PASSWORD=
TIGERGRAPH_GRAPH=benchmark

# ---------- Benchmark run settings ----------
BENCH_ITERATIONS=100
BENCH_CONCURRENCY_LEVELS=1,10,40
BENCH_DATASET_PATH=./data/prepared
