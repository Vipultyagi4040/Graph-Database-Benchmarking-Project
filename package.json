{
  "name": "cognodb-benchmark",
  "version": "1.0.0",
  "description": "Reproducible benchmark suite comparing CognoDB Cloud against Neo4j Aura, Memgraph Cloud, ArangoDB Oasis and TigerGraph Cloud on the same dataset and workloads.",
  "type": "module",
  "private": true,
  "scripts": {
    "dataset:fetch": "node scripts/fetch-dataset.js",
    "dataset:prepare": "node scripts/prepare-dataset.js",
    "load": "node src/runLoad.js",
    "bench": "node src/runBenchmark.js",
    "all": "node src/runAll.js",
    "report": "node scripts/build-report.js",
    "report:html": "node scripts/build-report-html.js",
    "simulate": "node scripts/simulate-results.js"
  },
  "dependencies": {
    "neo4j-driver": "^5.24.0",
    "arangojs": "^9.1.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "cli-progress": "^3.12.0",
    "csv-parse": "^5.5.6"
  },
  "engines": {
    "node": ">=18"
  }
}
